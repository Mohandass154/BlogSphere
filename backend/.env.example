# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/blogsphere?retryWrites=true&w=majority
# If left empty, BlogSphere will use an in-memory MongoDB instance for quick local development
MONGODB_URI=

# JWT Secret Key for token signing
JWT_SECRET=your_jwt_secret_key_here

# Environment
NODE_ENV=development
